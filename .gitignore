# ==========================================================================
# Radar Tracker — .gitignore
# Security-first: deny-list for anything that could leak secrets or bloat the
# repo. If you must commit an example of a sensitive file, name it *.example
# (those are explicitly re-included at the bottom).
# ==========================================================================

# --------------------------------------------------------------------------
# SECRETS & CREDENTIALS  (never commit these)
# --------------------------------------------------------------------------
# Environment / dotenv files
.env
.env.*
*.env
!*.env.example
!.env.example

# Private keys, certificates, keystores
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.der
*.jks
*.keystore
*.pub
id_rsa
id_dsa
id_ecdsa
id_ed25519
*_rsa
*_dsa
*_ecdsa
*_ed25519

# SSH / GPG
.ssh/
*.gpg
*.asc
secring.*

# Cloud / provider credentials
.aws/
aws.json
credentials
*credentials*
.netrc
.npmrc
.pypirc
gcloud-service-key.json
*service-account*.json
*-sa.json

# Generic secret-ish names
*secret*
*secrets*
*.secret
*token*
*.token
*password*
*.pwd
apikey*
*api_key*
*.apikey

# Terraform / infra state (often contains secrets)
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform/

# --------------------------------------------------------------------------
# C++ / CMake BUILD ARTIFACTS
# --------------------------------------------------------------------------
build/
build-*/
cmake-build-*/
_deps/
out/
install/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
Testing/

# Object files, libraries, executables
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.lo
*.slo
*.la

# Debug / profiling / sanitizer output
*.dSYM/
*.su
*.idb
*.pdb
*.gcno
*.gcda
*.gcov
callgrind.out.*
massif.out.*
vgcore.*
core
core.*
perf.data
perf.data.old
coverage/
*.lcov
lcov.info

# --------------------------------------------------------------------------
# PROJECT RUNTIME OUTPUT  (generated data; keep the repo code-only)
# --------------------------------------------------------------------------
# Simulator / tracker / scorer outputs
out/
output/
results/
*.csv
*.json.out
metrics.json
truth.csv
meas.csv
tracks.csv
# ...but keep scenario configs and any committed sample data
!scenarios/**/*.json
!**/*.example.json
# Generated plots / recordings (large binaries)
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.log
!Documentation/**/*.png
!README*/**/*.png

# --------------------------------------------------------------------------
# PYTHON  (tools/plot.py and its venv)
# --------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
pip-log.txt

# --------------------------------------------------------------------------
# IDE / EDITOR
# --------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.cache/
.ccls-cache/
.clangd/
tags
TAGS

# --------------------------------------------------------------------------
# OS CRUFT
# --------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --------------------------------------------------------------------------
# EXPLICIT RE-INCLUDES  (safe templates that SHOULD be committed)
# These win over the deny-rules above because they come last.
# --------------------------------------------------------------------------
!*.example
!*.example.*
!*.sample
!.gitignore
!LICENSE
