# Radar Tracker static analysis configuration.
# Check groups per spec: bugprone, cppcoreguidelines, modernize, performance,
# readability, misc. Disabled checks are listed with a reason each.
#
# Disabled, with rationale:
#   - modernize-use-trailing-return-type:
#       stylistic only; the project uses leading return types.
#   - readability-identifier-length:
#       math code uses short names (x, P, F, H, S, K) that match the spec's
#       equations; enforcing minimum length would hurt readability here.
#   - cppcoreguidelines-avoid-magic-numbers / readability-magic-numbers:
#       re-enabled later once named constants exist; noisy against literal
#       matrix initializers during early milestones.
#   - misc-include-cleaner:
#       too aggressive with umbrella headers (Eigen) in this toolchain.

Checks: >
  bugprone-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  readability-*,
  misc-*,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -misc-include-cleaner

WarningsAsErrors: ''
HeaderFilterRegex: '.*/(include/radar|src)/.*'
FormatStyle: file
