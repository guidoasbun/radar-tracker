#ifndef RADAR_VERSION_HPP
#define RADAR_VERSION_HPP

#include <string_view>

/// Radar Tracker public API root namespace.
namespace radar {

/// Semantic version of the library, single-sourced from the CMake project()
/// VERSION via configure_file. Units: none.
inline constexpr std::string_view kVersion = "@PROJECT_VERSION@";

/// Returns the library version string (e.g. "0.0.1"). Units: none.
[[nodiscard]] constexpr std::string_view version_string() noexcept { return kVersion; }

}  // namespace radar

#endif  // RADAR_VERSION_HPP
